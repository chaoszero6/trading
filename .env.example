# Copy to .env and fill in real values.  .env is gitignored — never commit it.
#   cp .env.example .env && chmod 600 .env

# ---- Angel One SmartAPI credentials --------------------------------
# Create an app + API key at https://smartapi.angelbroking.com/
ANGEL_API_KEY=your_api_key_here
# Your Angel One client code (e.g. A123456)
ANGEL_CLIENT_ID=your_client_id_here
# Angel One account / PIN used for the loginByPassword call
ANGEL_PASSWORD=your_password_here
# TOTP secret (base32 string, NOT a 6-digit code). TOTP must be enabled on the account.
ANGEL_TOTP_TOKEN=your_totp_token_here

# ---- Discord -------------------------------------------------------
# Webhook for entry / exit / guard alerts and the daily report
DISCORD_WEBHOOK=your_webhook_url_here
# Bot used for live commands (leave blank to run webhook-only)
DISCORD_BOT_TOKEN=your_bot_token_here
# Channel ID the bot posts to
DISCORD_CHANNEL_ID=your_channel_id_here
